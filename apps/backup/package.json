  "main": "index.js",
  "type": "module",
  "scripts": {
    "dev": "DATABASE_URL=file:./dev.db prisma generate && tsc --build --watch",
    "dev:db": "concurrently --names build,run --handle-input --default-input-target run \"pnpm:dev\" \"pnpm:watch:db\" ",
    "dev:backup": "concurrently --names build,run --handle-input --default-input-target run \"pnpm:dev\" \"pnpm:watch:backup\" ",
    "build": "prisma generate && tsc --build",
    "start:db": "node ./dist/db-worker.js",
    "start:backup": "node ./dist/db-worker.js",
    "watch:db": "node --watch ./dist/db-worker.js",
    "watch:backup": "node --watch ./dist/backup.js"
  },
