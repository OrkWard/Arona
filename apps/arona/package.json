{
  "name": "arona",
  "type": "module",
  "scripts": {
    "config": "op inject --in-file example.env --out-file .env -f",
    "dev": "concurrently --names build,run --handle-input --default-input-target run \"pnpm:dev-build\" \"pnpm:dev-start\" ",
    "dev-build": "tsc --build --watch",
    "dev-start": "STATIC_ROOT=$(realpath \"assets\") node --env-file .env --watch ./dist/main.js",
    "build": "tsc --build",
    "start": "STATIC_ROOT=$(realpath \"assets\") node --env-file .env ./dist/main.js"
  },
  "devDependencies": {
    "@types/koa": "catalog:",
    "@types/node": "catalog:",
    "concurrently": "catalog:",
    "typescript": "catalog:"
  },
  "dependencies": {
    "@effect/platform": "^0.94.1",
    "@effect/platform-node": "^0.104.0",
    "@koa/send": "catalog:",
    "@sentry/node": "catalog:",
    "effect": "^3.19.14",
    "got": "catalog:",
    "html-entities": "^2.5.2",
    "https-proxy-agent": "catalog:",
    "koa": "catalog:",
    "onebot": "workspace:*",
    "pino": "catalog:",
    "pino-pretty": "catalog:",
    "redis": "^5.0.0",
    "wormface-openapi": "workspace:*"
  }
}
